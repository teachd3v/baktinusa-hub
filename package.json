{
  "name": "baktinusa-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm",
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "papaparse": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply baktinusa-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply baktinusa-hub-db --remote",
    "seed:ba15": "node scripts/seed-ba15.mjs",
    "demo-data": "node scripts/demo-data.mjs",
    "akun-dummy": "node --experimental-strip-types scripts/akun-dummy.mjs",
    "test": "node --test --no-warnings \"tests/*.test.ts\"",
    "login-link": "node scripts/login-link.mjs"
  }
}
